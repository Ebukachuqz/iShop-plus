# iShop-plus (Drake) - Environment Configuration Example
# Copy this file to .env and supply actual values for your local or development deployment.
# Do not commit real credentials or private keys.

# =============================================================================
# Shopify App & Storefront Configuration
# =============================================================================
SHOPIFY_APP_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_APP_CLIENT_SECRET=your_shopify_app_client_secret
SHOPIFY_APP_URL=https://localhost:3000
SHOPIFY_STORE_PASSWORD=your_development_storefront_password
SHOPIFY_SCOPES=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Local development restrictions (comma-separated)
DEV_ALLOWED_SHOP_DOMAINS=example-store.myshopify.com
DEV_ALLOWED_ORIGINS=https://example-store.myshopify.com

# =============================================================================
# Drake Runtime Service
# =============================================================================
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8000
RUNTIME_URL=http://127.0.0.1:8000
RUNTIME_WSS_URL=ws://127.0.0.1:8000/ws
# Service-owned persistent SQLite storage paths (git-ignored)
RUNTIME_DATABASE_PATH=services/runtime/data/ishop_runtime.sqlite
# Mount apps/shopify/prisma on persistent storage in hosted deployments.

# Session & Grant Security
# Secret key used to sign and verify short-lived shopper session grants (minimum 32 random chars)
SESSION_SIGNING_SECRET=replace_with_a_secure_random_signing_secret_min_32_chars
# Optional separate credential for authenticated runtime revocation controls.
# When omitted, the runtime uses SESSION_SIGNING_SECRET.
RUNTIME_CONTROL_SECRET=replace_with_a_different_secure_random_secret_min_32_chars
SESSION_TTL_SECONDS=1800

# =============================================================================
# Merchant & Active Profile Selection (Server-side IDs)
# =============================================================================
# Enabled profile IDs (must match approved registry entries in CONFIGURATION.md)
DEFAULT_ASR_PROFILE=elevenlabs-scribe-v2-realtime
DEFAULT_LLM_PROFILE=gemini-flash
DEFAULT_TTS_PROFILE=elevenlabs-tts-female-stream

# =============================================================================
# Speech Recognition & Synthesis Provider Credentials (Server-side only)
# =============================================================================
# Legacy voice credentials below are used only by archived evaluations.
SAHARA_API_TOKEN=your_intron_sahara_bearer_token
SAHARA_API_KEY=your_intron_sahara_bearer_token
SAHARA_TRANSCRIBE_URL=https://infer.voice.intron.io/file/v1/upload/sync
SAHARA_LANGUAGE_CODE=pcm
SAHARA_STT_WS_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_TTS_WS_URL=wss://infer.voice.intron.io/tts/v1/stream
# Enable only after verifying the exact female Pidgin-English tuple on this account.
ISHOP_ENABLE_SAHARA_PIDGIN_TTS=false

# Groq Whisper Large v3 and AssemblyAI (Benchmark competitors)
GROQ_API_KEY=your_groq_api_key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
ISHOP_ENABLE_ASSEMBLYAI_REALTIME_STT=false

# ElevenLabs is the only active iShop-plus speech provider.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ISHOP_ENABLE_ELEVENLABS_REALTIME_STT=true
ISHOP_ENABLE_ELEVENLABS_HTTP_TTS=true
ISHOP_ENABLE_ELEVENLABS_WS_TTS=false
# Sarah was confirmed through the account voice list and an actual synthesis call.
# Set another account-accessible voice here when needed.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5


# =============================================================================
# LLM Providers (Independent & Configurable)
# =============================================================================
# Google Gemini Developer API (Eligible for free tier development)
GEMINI_API_KEY=your_gemini_api_key
# Exact production model behind the stable merchant profile `gemini-flash`.
GEMINI_MODEL=gemini-3.8-flash
# Vision/Missions provider, independent of ordinary chat; NVIDIA uses google/gemma-4-31b-it.
NVIDIA_API_KEY=your_nvidia_api_key
ISHOP_PLUS_GEMMA_PROVIDER=groq
# Google model below applies only when ISHOP_PLUS_GEMMA_PROVIDER=google.
ISHOP_PLUS_VISION_ENABLED=true
ISHOP_PLUS_MISSIONS_ENABLED=true
ISHOP_PLUS_GEMMA_MODEL=gemma-4-26b-a4b-it
ISHOP_ENABLE_GEMINI_LIVE_STT=false
ISHOP_ENABLE_GEMINI_TTS=false
ISHOP_ENABLE_GROQ_TTS=false

# The Groq credential can also enable the optional Groq LLM profile.

# =============================================================================
# Research, Logging & Safety Boundaries
# =============================================================================
# Audio recording is disabled by default for shopper privacy
RECORD_AUDIO_ENABLED=false
# Local storage path for private consented audio fixtures (git-ignored)
RESEARCH_DATA_PATH=data/private/
# Operational log retention days
LOG_RETENTION_DAYS=7

# Optional explicit free Gemma image route (no paid fallback).
OPENROUTER_API_KEY=your_openrouter_api_key
# ISHOP_PLUS_GEMMA_PROVIDER=openrouter

# Runtime fallback only; explicit merchant choices override for new signed sessions.
# Vision/Missions: groq (Qwen 3.8 27B), openrouter, nvidia, google (Gemma 4).
# Groq uses the existing GROQ_API_KEY; ElevenLabs voice is unaffected.
